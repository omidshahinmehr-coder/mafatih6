<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Mafatih" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_gold</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:fontFamily">@font/estedad</item>
        <item name="fontFamily">@font/estedad</item>
        <!-- App content is always Persian/Arabic, so force RTL layout for
             every screen regardless of the device's system language (a
             phone set to English would otherwise render everything
             left-aligned, since layout direction normally follows locale). -->
        <item name="android:layoutDirection">rtl</item>
    </style>

    <style name="Theme.Mafatih.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="Theme.Mafatih.Splash" parent="Theme.Mafatih">
        <item name="android:windowBackground">@color/night_sky_blue</item>
        <item name="android:statusBarColor">@color/night_sky_blue</item>
    </style>

</resources>
