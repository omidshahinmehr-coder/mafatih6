<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_app">

    <androidx.appcompat.widget.Toolbar
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:theme="@style/Theme.Mafatih.Toolbar"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
        app:titleTextColor="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Live preview -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp"
                    android:text="بِسْمِ اللهِ الرَّحْمنِ الرَّحيمِ"
                    android:textDirection="rtl"
                    android:textAlignment="center"
                    android:textSize="20sp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/SectionLabel" android:text="@string/settings_font" />
            <RadioGroup
                android:id="@+id/rgFont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFontEstedad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="استعداد (پیش‌فرض)" />

                <RadioButton
                    android:id="@+id/rbFontNeirizi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="نیریزی" />

                <RadioButton
                    android:id="@+id/rbFontEntezar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="انتظار" />

                <RadioButton
                    android:id="@+id/rbFontIranianSans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="ایرانیان سنس" />

                <RadioButton
                    android:id="@+id/rbFontSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="قلم سیستم" />
            </RadioGroup>

            <TextView style="@style/SectionLabel" android:text="@string/settings_font_size" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvFontSizeValue"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekFontSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="22" />
            </LinearLayout>

            <TextView style="@style/SectionLabel" android:text="@string/settings_dua_color" />
            <LinearLayout
                android:id="@+id/rowDuaColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView style="@style/SectionLabel" android:text="@string/settings_translate_color" />
            <LinearLayout
                android:id="@+id/rowTranslateColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView style="@style/SectionLabel" android:text="@string/settings_bg_color" />
            <LinearLayout
                android:id="@+id/rowBgColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_show_translate"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/switchShowTranslate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_reset"
                android:backgroundTint="@color/primary_light" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
