<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup / device-to-device transfer rules. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="mafatih.db" />
        <include domain="sharedpref" path="mafatih_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="mafatih.db" />
        <include domain="sharedpref" path="mafatih_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
